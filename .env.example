# FastAPI
APP_NAME=Kinova
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Kinoheld GraphQL API
KINOHELD_GRAPHQL_URL=https://graph.kinoheld.de/graphql/v1/query
KINOHELD_REQUEST_TIMEOUT=30.0
KINOHELD_POOL_LIMITS=10

# Optional: affiliate key for commissionable links
KINOHELD_AFFILIATE_KEY=

# Cinetixx legacy showtime endpoint
CINETIXX_SHOW_INFO_URL=https://api.cinetixx.de/Services/CinetixxService.asmx/GetShowInfoV6
CINETIXX_CINEMA_SEARCH_URL=https://booking.cinetixx.de/api/cinemas/
CINETIXX_REQUEST_TIMEOUT=30.0
CINETIXX_POOL_LIMITS=10
CINETIXX_SYNC_INTERVAL_SECONDS=3600
# Comma-separated values are accepted; leave blank to disable startup seeding.
# Optional additional mandator IDs. Discovery runs automatically from the public cinema index.
# Example: CINETIXX_SYNC_MANDATOR_IDS=1627457285,42
CINETIXX_SYNC_MANDATOR_IDS=
# Optional additional cinema searches, useful only if an operator is missing from the index.
# Example: CINETIXX_SYNC_DISCOVERY_SEARCHES=ACUDkino
CINETIXX_SYNC_DISCOVERY_SEARCHES=
CINETIXX_DISCOVERY_PAGE_SIZE=100
CINETIXX_DISCOVERY_MAX_PAGES=100
# Optional override for public-index enumeration terms. Blank uses a-z and 0-9.
CINETIXX_DISCOVERY_TERMS=
CINETIXX_SYNC_SHOW_DAYS=7

# Kinoheld cache / sync settings
KINOHELD_SYNC_INTERVAL_SECONDS=600
# Comma-separated cinema IDs to always pre-fetch shows for. Usually left blank:
# KINOHELD_SYNC_CINEMA_COUNT below pre-warms without a hand-maintained list.
KINOHELD_SYNC_CINEMA_IDS=
# Locations whose cinemas are pre-warmed first. The global catalogue is not ordered
# by relevance, so without this a small budget lands on arbitrary cinemas. These
# locations also skip the live backfill on /internal/cinemas?location=.
KINOHELD_SYNC_PRIORITY_LOCATIONS=Berlin
# Pre-fetch shows for the first N cinemas, priority locations first. 0 disables show
# pre-warming, which leaves /internal/health's cached_shows at 0 and makes the first
# /internal/shows request for each cinema pay a live fetch.
KINOHELD_SYNC_CINEMA_COUNT=50
# Concurrent show requests during refresh. 25 cinemas x 7 days = 175 requests, so
# refreshing serially would dominate startup.
KINOHELD_SYNC_CONCURRENCY=8
KINOHELD_SYNC_SHOW_DAYS=7
# How long a cached cinema/date entry is served before a read re-fetches it. An empty
# day cannot be treated as a miss (dark venues are legitimately empty), so age is what
# separates stale from "no shows".
KINOHELD_SHOW_CACHE_TTL_SECONDS=1800
# How far ahead cached show entries are kept and re-fetched. Kinoheld only publishes
# about a week out, so days cached beyond the sync window start empty and must be
# re-fetched rather than frozen; this bounds how many such days accumulate.
KINOHELD_SHOW_CACHE_HORIZON_DAYS=21
KINOHELD_SYNC_MOVIE_LIMIT=100
# Max live movie lookups per show batch used to backfill show-embedded genres for
# films outside the cached catalog slice.
KINOHELD_GENRE_LOOKUP_LIMIT=100
# The cache holds a global slice; location queries backfill from live on top of it.
KINOHELD_SYNC_CINEMA_LIMIT=1000

# Yorck cache / sync settings
YORCK_SYNC_INTERVAL_SECONDS=3600
YORCK_SYNC_SHOW_DAYS=7
# Enrich every film from its detail page (directors, cast, description, trailer, TMDB).
YORCK_FETCH_FILM_DETAILS=true
YORCK_DETAIL_CONCURRENCY=8
# Per-session allocatedSeating lookup, used to point each show's bookingUrl at the
# right yorck.de checkout step. Disabling it links every session to seat selection.
YORCK_FETCH_SESSION_SEATING=true
# Public read-only Contentful credentials published in the yorck.de web bundle.
# Normally leave these alone: if Yorck rotates them, the client re-scrapes the pair
# from the site bundle on the first 401 and carries on. Set them only to pin a
# specific space/token or if the scrape itself stops working.
YORCK_CONTENTFUL_SPACE_ID=4mws6uyas4ta
YORCK_CONTENTFUL_ACCESS_TOKEN=UNY_7-kVS3UkYxAMEIpyO2g7Lh-8e7645oGt2ksDhE8

# LLM provider for natural-language search (OpenAI-compatible API)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_REQUEST_TIMEOUT=60.0
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_FALLBACK_SEARCH_ENABLED=true
# Real catalogue genre tags shown to the parser so it stops inventing names that do
# not exist ("Comedy" against a German "Komödie" catalogue). Ranked by how many cached
# movies use each tag, so a short list still covers most queries; each tag costs
# prompt tokens, so raise it only if genre searches still miss. 0 disables grounding.
NL_GENRE_VOCABULARY_LIMIT=60
